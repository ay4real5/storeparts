# Copy to .env and fill in. Never commit .env — this repo is public.

# --- Core (required) ---
DATABASE_URL="postgresql://carparts:carparts@localhost:5433/storeparts?schema=public"
SITE_URL="http://localhost:3000"
STORE_NAME="StoreParts"
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Used by `npm run db:seed` to create/reset the admin login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Stripe (payments, Apple Pay, tax) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Turn on after enabling Stripe Tax and adding your tax registrations in the dashboard.
STRIPE_TAX_ENABLED="false"

# --- EasyPost (rates + labels). Without it, dev uses placeholder rates. ---
EASYPOST_API_KEY=""
EASYPOST_WEBHOOK_SECRET=""
SHIP_FROM_NAME=""
SHIP_FROM_COMPANY=""
SHIP_FROM_STREET1=""
SHIP_FROM_STREET2=""
SHIP_FROM_CITY=""
SHIP_FROM_STATE=""
SHIP_FROM_ZIP=""
SHIP_FROM_PHONE=""

# --- Email (Resend). Without it, emails print to the server log. ---
RESEND_API_KEY=""
EMAIL_FROM="StoreParts <orders@yourdomain.com>"
ADMIN_NOTIFY_EMAIL=""

# --- Images (Cloudinary). Without it, uploads go to UPLOAD_DIR. ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_DIR="./uploads"

# --- Jobs ---
# Bearer token for GET /api/cron/release-reservations (run every ~10 min).
CRON_SECRET=""

# --- Tunables (defaults shown) ---
# RESERVATION_MINUTES=30
# RETURN_WINDOW_DAYS=30
# CORE_RETURN_WINDOW_DAYS=90
# LOW_STOCK_THRESHOLD=3
