// Car parts store schema. Money is stored as integer cents everywhere.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id              String         @id @default(cuid())
  sku             String         @unique
  slug            String         @unique
  title           String
  brand           String?
  description     String         @default("")
  priceCents      Int
  compareAtCents  Int?
  // Refundable deposit charged on remanufactured parts (alternators, starters, calipers...).
  coreChargeCents Int            @default(0)
  stockQty        Int            @default(0)
  // Shipping box for one unit. Carriers bill bulky parts by dimensional weight.
  weightOz        Float
  lengthIn        Float
  widthIn         Float
  heightIn        Float
  // Batteries, fluids, aerosols: restricted to ground services.
  hazmat          Boolean        @default(false)
  // Fits every vehicle (fluids, tools, universal accessories); skips the fitment filter.
  universalFit    Boolean        @default(false)
  status          ProductStatus  @default(DRAFT)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  fitments        Fitment[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([productId])
}

// One row covers a year range, e.g. 2015-2020 Toyota Camry LE 2.5L.
model Fitment {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  yearStart Int
  yearEnd   Int
  make      String
  model     String
  submodel  String?
  engine    String?
  notes     String?

  @@index([productId])
  @@index([make, model, yearStart, yearEnd])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  orders    Order[]
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id                     String          @id @default(cuid())
  number                 Int             @unique @default(autoincrement())
  // Secret for customer-facing order links; order ids alone are never enough.
  accessToken            String          @unique
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])
  email                  String
  status                 OrderStatus     @default(PENDING_PAYMENT)
  subtotalCents          Int
  coreChargeCents        Int             @default(0)
  shippingCents          Int
  taxCents               Int             @default(0)
  totalCents             Int
  refundedCents          Int             @default(0)
  hazmat                 Boolean         @default(false)
  shipName               String
  shipLine1              String
  shipLine2              String?
  shipCity               String
  shipState              String
  shipZip                String
  shipCountry            String          @default("US")
  shipPhone              String?
  shippingCarrier        String?
  shippingService        String?
  easypostShipmentId     String?
  easypostRateId         String?
  stripePaymentIntentId  String?         @unique
  stripeTaxCalculationId String?
  // Stock is held for PENDING_PAYMENT orders until this time, then released.
  reservedUntil          DateTime?
  paidAt                 DateTime?
  items                  OrderItem[]
  shipments              Shipment[]
  returns                ReturnRequest[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([status, reservedUntil])
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  sku             String
  title           String
  qty             Int
  unitPriceCents  Int
  coreChargeCents Int          @default(0)
  returnItems     ReturnItem[]

  @@index([orderId])
}

model Shipment {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  isReturn           Boolean   @default(false)
  carrier            String
  service            String
  trackingNumber     String
  trackingStatus     String?
  trackingUrl        String?
  labelUrl           String
  rateCents          Int
  easypostShipmentId String    @unique
  easypostTrackerId  String?
  estDeliveryAt      DateTime?
  createdAt          DateTime  @default(now())

  @@index([orderId])
  @@index([trackingNumber])
}

enum ReturnType {
  RETURN
  CORE
}

enum ReturnReason {
  DOES_NOT_FIT
  DEFECTIVE
  WRONG_ITEM_SENT
  NOT_NEEDED
  CORE_RETURN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           ReturnType
  reason         ReturnReason
  customerNotes  String?
  adminNotes     String?
  status         ReturnStatus @default(REQUESTED)
  refundCents    Int?
  stripeRefundId String?
  items          ReturnItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  returnReq   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  qty         Int
}

// Processed webhook event ids, so Stripe/EasyPost retries are applied once.
model WebhookEvent {
  id          String   @id
  source      String
  type        String
  processedAt DateTime @default(now())
}
